/* ════════════════════════════════════════════════════════════════════════════
   Hospitality OS — Sistema de diseño global
   Tokens + clases base de los componentes custom (gos-*, reg-*, acct-*).
   Reconstruido para el template Hostals / Sakai con tema primario teal.
   ════════════════════════════════════════════════════════════════════════════ */

/* ────────────────────────────────────────────────────────────────────────────
   1) TOKENS
   ──────────────────────────────────────────────────────────────────────────── */
:root {
    /* Marca */
    --hos-primary: #14b8a6;
    --hos-brand: #0f766e;
    --hos-accent-rgb: 20, 184, 166;
    --hos-primary-soft: rgba(20, 184, 166, 0.1);
    --hos-grad: linear-gradient(135deg, #14b8a6 0%, #0ea5e9 55%, #6366f1 100%);

    /* Superficies */
    --hos-bg: #f5f7fb;
    --hos-bg-soft: #edf0f7;
    --hos-surface: #ffffff;
    --hos-surface-soft: #f8fafc;
    --hos-border: #e4e7ee;

    /* Texto */
    --hos-text: #1e293b;
    --hos-text-muted: #64748b;

    /* Gamas */
    --hos-teal-50: #f0fdfa;
    --hos-teal-200: #99f6e4;
    --hos-teal-300: #5eead4;
    --hos-teal-400: #2dd4bf;
    --hos-teal-500: #14b8a6;
    --hos-teal-600: #0d9488;
    --hos-teal-700: #0f766e;
    --hos-slate-300: #cbd5e1;
    --hos-slate-500: #64748b;
    --hos-slate-600: #475569;
    --hos-slate-700: #334155;
    --hos-slate-800: #1e293b;
    --hos-slate-900: #0f172a;
    --hos-slate-950: #020617;

    /* Tipografía */
    --hos-font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --hos-font-display: 'Plus Jakarta Sans', 'Inter', ui-sans-serif, system-ui, sans-serif;

    /* Radio / sombras */
    --hos-radius-lg: 1.25rem;
    --hos-shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06);
    --hos-shadow: 0 12px 32px -14px rgba(15, 23, 42, 0.18);
    --hos-shadow-lg: 0 28px 70px -28px rgba(15, 23, 42, 0.4);
}

.app-dark {
    --hos-bg: #0b1220;
    --hos-bg-soft: #0d1526;
    --hos-surface: #111a2c;
    --hos-surface-soft: #0e1726;
    --hos-border: #22304a;
    --hos-text: #e2e8f0;
    --hos-text-muted: #94a3b8;
    --hos-primary-soft: rgba(45, 212, 191, 0.14);
    --hos-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.5);
    --hos-shadow: 0 12px 32px -14px rgba(0, 0, 0, 0.55);
    --hos-shadow-lg: 0 28px 70px -28px rgba(0, 0, 0, 0.7);
}

html {
    scroll-behavior: smooth;
}

/* ────────────────────────────────────────────────────────────────────────────
   2) PRIMITIVAS DE LAYOUT
   ──────────────────────────────────────────────────────────────────────────── */
.gos-container {
    width: min(1160px, calc(100% - 48px));
    margin-inline: auto;
}

.gos-container--narrow {
    width: min(860px, calc(100% - 48px));
}

.gos-section {
    padding: clamp(56px, 8vw, 104px) 0;
    position: relative;
}

.gos-section--soft {
    background: var(--hos-bg-soft);
}

.gos-section-head {
    max-width: 720px;
    margin: 0 auto clamp(40px, 6vw, 64px);
    text-align: center;
}

.gos-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hos-primary);
    background: var(--hos-primary-soft);
    border: 1px solid rgba(20, 184, 166, 0.2);
    padding: 8px 16px;
    border-radius: 999px;
    margin-bottom: 18px;
}

.gos-eyebrow--center {
    justify-content: center;
}

.gos-title {
    font-family: var(--hos-font-display);
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--hos-text);
    margin: 0 0 16px;
}

.gos-title--center {
    text-align: center;
}

.gos-subtitle {
    font-size: 1.06rem;
    line-height: 1.65;
    color: var(--hos-text-muted);
    margin: 0;
}

.gos-grad-text {
    background: var(--hos-grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
}

.gos-muted {
    color: var(--hos-text-muted);
}

.gos-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--hos-primary-soft);
    color: var(--hos-primary);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
}

.gos-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hos-primary);
    display: inline-block;
}

.gos-link {
    color: var(--hos-primary);
    font-weight: 600;
    text-decoration: none;
    transition: color 0.18s ease;
}

.gos-link:hover {
    color: var(--hos-brand);
    text-decoration: underline;
}

.gos-text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--hos-primary);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    transition: gap 0.18s ease, color 0.18s ease;
}

.gos-text-link:hover {
    gap: 12px;
    color: var(--hos-brand);
}

/* ────────────────────────────────────────────────────────────────────────────
   3) BOTONES
   ──────────────────────────────────────────────────────────────────────────── */
.gos-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--hos-font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
    padding: 14px 26px;
    border-radius: 14px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 0.18s ease, box-shadow 0.2s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
}

.gos-btn:focus-visible {
    outline: 3px solid rgba(20, 184, 166, 0.35);
    outline-offset: 2px;
}

.gos-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.gos-btn--primary {
    background: var(--hos-grad);
    color: #fff;
    box-shadow: 0 12px 28px -12px rgba(20, 184, 166, 0.55);
}

.gos-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -14px rgba(20, 184, 166, 0.6);
    color: #fff;
}

.gos-btn--ghost {
    background: var(--hos-surface);
    color: var(--hos-text);
    border-color: var(--hos-border);
}

.gos-btn--ghost:hover {
    border-color: var(--hos-primary);
    color: var(--hos-primary);
    transform: translateY(-2px);
}

.gos-btn--light {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(8px);
}

.gos-btn--light:hover {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
}

.gos-btn--block {
    width: 100%;
}

/* ────────────────────────────────────────────────────────────────────────────
   4) FORMULARIOS
   ──────────────────────────────────────────────────────────────────────────── */
.gos-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.gos-field label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--hos-text);
}

.gos-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
}

@media (max-width: 560px) {
    .gos-form-row {
        grid-template-columns: 1fr;
    }
}

.gos-input {
    width: 100%;
    font-family: var(--hos-font-sans);
    font-size: 0.95rem;
    color: var(--hos-text);
    background: var(--hos-surface);
    border: 1.5px solid var(--hos-border);
    border-radius: 14px;
    padding: 13px 16px;
    outline: none;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
}

.gos-input:focus {
    border-color: var(--hos-primary);
    box-shadow: 0 0 0 4px var(--hos-primary-soft);
}

.gos-input::placeholder {
    color: var(--hos-text-muted);
    opacity: 0.75;
}

.gos-input--area {
    resize: vertical;
    min-height: 120px;
}

.gos-error {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #dc2626;
    background: rgba(220, 38, 38, 0.08);
    border: 1px solid rgba(220, 38, 38, 0.18);
    padding: 10px 14px;
    border-radius: 12px;
}

.gos-success {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--hos-teal-700);
    background: var(--hos-primary-soft);
    border: 1px solid rgba(20, 184, 166, 0.25);
    padding: 12px 16px;
    border-radius: 12px;
}

.gos-spinner {
    width: 16px;
    height: 16px;
    border: 2.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    display: inline-block;
    animation: gos-spin 0.7s linear infinite;
}

/* ────────────────────────────────────────────────────────────────────────────
   5) MARCA
   ──────────────────────────────────────────────────────────────────────────── */
.gos-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
}

.gos-brand__mark {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--hos-grad);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 1.05rem;
    box-shadow: 0 10px 22px -10px rgba(20, 184, 166, 0.6);
}

.gos-brand__name {
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: var(--hos-text);
    line-height: 1;
    display: flex;
    flex-direction: column;
}

.gos-brand__os {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hos-primary);
}

/* ────────────────────────────────────────────────────────────────────────────
   6) NAVEGACIÓN
   ──────────────────────────────────────────────────────────────────────────── */
.gos-nav {
    position: sticky;
    top: 0;
    z-index: 80;
    background: color-mix(in srgb, var(--hos-surface) 86%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--hos-border);
}

.gos-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 0;
}

.gos-nav__links {
    display: flex;
    align-items: center;
    gap: 4px;
}

.gos-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--hos-text);
    text-decoration: none;
    transition: color 0.16s ease, background 0.16s ease;
}

.gos-nav__link:hover {
    color: var(--hos-primary);
    background: var(--hos-primary-soft);
}

.gos-nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.gos-nav__toggle {
    background: none;
    border: 1px solid var(--hos-border);
    border-radius: 10px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: var(--hos-text);
    transition: border-color 0.16s ease;
}

.gos-nav__toggle:hover {
    border-color: var(--hos-primary);
}

.gos-nav__burger {
    display: none;
}

.gos-nav__mobile {
    display: none;
}

@media (max-width: 960px) {
    .gos-nav__links,
    .gos-nav__actions {
        display: none;
    }
    .gos-nav__burger {
        display: inline-flex;
    }
    .gos-nav__mobile {
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--hos-border);
        padding: 12px 16px 20px;
    }
    .gos-nav__mobile-actions {
        display: flex;
        gap: 10px;
        padding: 4px 14px 10px;
    }
    .gos-nav__mobile-position {
        display: flex;
        flex-direction: column;
    }
}

.gos-pop-position {
    position: relative;
}

/* Swatches de color */
.gos-nav__swatch {
    background: none;
    border: 0;
    cursor: pointer;
    font-size: 1.05rem;
}

/* ────────────────────────────────────────────────────────────────────────────
   7) FOOTER
   ──────────────────────────────────────────────────────────────────────────── */
.gos-footer {
    background: var(--hos-bg-soft);
    border-top: 1px solid var(--hos-border);
    padding: 64px 0 28px;
    margin-top: auto;
}

.gos-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 44px;
}

@media (max-width: 900px) {
    .gos-footer__grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 540px) {
    .gos-footer__grid {
        grid-template-columns: 1fr;
    }
}

.gos-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
}

.gos-footer__tagline {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--hos-text-muted);
    max-width: 280px;
}

.gos-footer__col {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.gos-footer__col-title {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hos-text);
    margin-bottom: 6px;
}

.gos-footer__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.gos-footer__link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--hos-text-muted);
    text-decoration: none;
    transition: color 0.16s ease;
}

.gos-footer__link:hover {
    color: var(--hos-primary);
}

.gos-footer__social {
    display: flex;
    gap: 8px;
    margin-top: 6px;
}

.gos-footer__social a {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    border: 1px solid var(--hos-border);
    background: var(--hos-surface);
    color: var(--hos-text-muted);
    display: grid;
    place-items: center;
    font-size: 1rem;
    text-decoration: none;
    transition: border-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
}

.gos-footer__social a:hover {
    border-color: var(--hos-primary);
    color: var(--hos-primary);
    transform: translateY(-2px);
}

.gos-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding-top: 22px;
    border-top: 1px solid var(--hos-border);
    font-size: 0.85rem;
    color: var(--hos-text-muted);
}

/* ────────────────────────────────────────────────────────────────────────────
   8) AUTH / LOGIN
   ──────────────────────────────────────────────────────────────────────────── */
.gos-auth-card {
    position: relative;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 26px;
    box-shadow: var(--hos-shadow-lg);
    padding: 40px;
    overflow: hidden;
}

@media (max-width: 520px) {
    .gos-auth-card {
        padding: 28px 22px;
        border-radius: 20px;
    }
}

.auth-sep {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--hos-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.auth-sep::before,
.auth-sep::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--hos-border);
}

.auth-foot {
    text-align: center;
    font-size: 0.9rem;
    color: var(--hos-text-muted);
}

.auth-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

@media (max-width: 520px) {
    .auth-grid-2 {
        grid-template-columns: 1fr;
    }
}

/* ────────────────────────────────────────────────────────────────────────────
   9) HERO
   ──────────────────────────────────────────────────────────────────────────── */
.gos-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
        radial-gradient(52% 60% at 15% 12%, rgba(20, 184, 166, 0.32) 0%, transparent 60%),
        radial-gradient(46% 55% at 88% 8%, rgba(99, 102, 241, 0.34) 0%, transparent 62%),
        linear-gradient(160deg, #0b1526 0%, #0d1830 45%, #0f172a 100%);
    color: #fff;
    padding: clamp(84px, 12vh, 148px) 0 clamp(90px, 12vw, 150px);
    text-align: center;
}

.gos-hero__pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(70% 60% at 50% 20%, #000 30%, transparent 75%);
    mask-image: radial-gradient(70% 60% at 50% 20%, #000 30%, transparent 75%);
}

.gos-hero__rings {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
}

.gos-hero__ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.gos-hero__ring--1 {
    width: 560px;
    height: 560px;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

.gos-hero__ring--2 {
    width: 820px;
    height: 820px;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

.gos-hero__ring--3 {
    width: 1080px;
    height: 1080px;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
}

.gos-hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
    z-index: -1;
    background: rgba(20, 184, 166, 0.4);
    width: 340px;
    height: 340px;
    top: -60px;
    left: -80px;
}

.gos-hero__orb--alt {
    background: rgba(99, 102, 241, 0.35);
    width: 300px;
    height: 300px;
    bottom: -40px;
    right: -60px;
    top: auto;
    left: auto;
}

.gos-hero__orb--alt2 {
    background: rgba(14, 165, 233, 0.3);
    width: 240px;
    height: 240px;
    top: 40%;
    right: 30%;
    left: auto;
}

.gos-hero__content {
    position: relative;
    z-index: 2;
}

.gos-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 24px;
    animation: gos-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
}

.gos-hero__title {
    font-family: var(--hos-font-display);
    font-size: clamp(2.3rem, 6vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: 0 auto 22px;
    max-width: 900px;
    animation: gos-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
}

.gos-hero__subtitle {
    font-size: clamp(1rem, 1.6vw, 1.22rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    max-width: 640px;
    margin: 0 auto 36px;
    animation: gos-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
}

.gos-hero__ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    animation: gos-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
}

.gos-hero__micro {
    margin-top: 26px;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
    animation: gos-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.45s both;
}

.gos-hero__mock {
    position: relative;
    margin-top: 64px;
    animation: gos-fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
}

.gos-hero__mock-enter {
    position: relative;
}

/* ────────────────────────────────────────────────────────────────────────────
   10) MARQUEE
   ──────────────────────────────────────────────────────────────────────────── */
.gos-marquee {
    position: relative;
    overflow: hidden;
    padding: 26px 0;
    border-block: 1px solid var(--hos-border);
    background: var(--hos-surface);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
}

.gos-marquee__track {
    display: flex;
    align-items: center;
    gap: 48px;
    width: max-content;
    animation: gos-marquee 30s linear infinite;
}

.gos-marquee:hover .gos-marquee__track {
    animation-play-state: paused;
}

.gos-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--hos-text-muted);
    white-space: nowrap;
}

.gos-marquee__sep {
    color: var(--hos-primary);
}

/* ────────────────────────────────────────────────────────────────────────────
   11) FEATURES / MÓDULOS / SOLUCIONES
   ──────────────────────────────────────────────────────────────────────────── */
.gos-feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
}

.gos-feature-chip {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 18px;
    padding: 18px 20px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.gos-feature-chip:hover {
    transform: translateY(-3px);
    border-color: rgba(20, 184, 166, 0.4);
    box-shadow: var(--hos-shadow);
}

.gos-feature-chip__icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    font-size: 1.15rem;
    color: var(--hos-primary);
    background: var(--hos-primary-soft);
}

.gos-modules,
.gos-solution-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
}

.gos-module-card,
.gos-solution-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 22px;
    padding: 26px;
    text-decoration: none;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.gos-module-card:hover,
.gos-solution-card:hover {
    transform: translateY(-4px);
    border-color: rgba(20, 184, 166, 0.45);
    box-shadow: var(--hos-shadow);
}

.gos-module-card__icon,
.gos-solution-card__icon {
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: var(--hos-grad);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 1.35rem;
    box-shadow: 0 14px 26px -12px rgba(20, 184, 166, 0.6);
}

.gos-module-card__title,
.gos-solution-card__title h3 {
    font-family: var(--hos-font-display);
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--hos-text);
    margin: 0;
}

.gos-module-card__desc,
.gos-solution-card__desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--hos-text-muted);
    margin: 0;
    flex: 1;
}

.gos-module-card__link,
.gos-solution-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--hos-primary);
    font-weight: 700;
    font-size: 0.9rem;
}

/* ────────────────────────────────────────────────────────────────────────────
   12) OPERACIONES / DETALLE DE MÓDULOS
   ──────────────────────────────────────────────────────────────────────────── */
.gos-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
}

@media (max-width: 880px) {
    .gos-split {
        grid-template-columns: 1fr;
        gap: 32px;
    }
}

.gos-check-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.gos-check-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--hos-text);
}

.gos-check-list li i {
    margin-top: 3px;
    color: var(--hos-primary);
    font-size: 1rem;
}

.gos-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
}

.gos-code-card {
    background: var(--hos-slate-900);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--hos-shadow-lg);
}

.gos-code-card__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.04);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.gos-code-card__bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #f87171;
    display: inline-block;
    font-size: 0;
}

.gos-code-card__bar i:nth-child(2) {
    background: #fbbf24;
}

.gos-code-card__bar i:nth-child(3) {
    background: #34d399;
}

.gos-code-card__title {
    margin-left: 8px;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--hos-font-display);
    font-weight: 600;
}

.gos-code-card pre {
    margin: 0;
    padding: 22px 24px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.6;
    color: #cbd5e1;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.gos-compare {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 18px;
    overflow: hidden;
}

.gos-compare__row {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
}

.gos-compare__row--head {
    background: var(--hos-bg-soft);
}

.gos-compare__cell {
    padding: 14px 18px;
    font-size: 0.9rem;
    color: var(--hos-text);
    border-top: 1px solid var(--hos-border);
}

.gos-compare__row:first-child .gos-compare__cell {
    border-top: 0;
    font-weight: 700;
    color: var(--hos-text);
}

.gos-compare__cell--head {
    font-weight: 800;
}

.gos-compare__label {
    color: var(--hos-text-muted);
}

.gos-compare__val {
    font-weight: 700;
}

.gos-compare__val i {
    color: var(--hos-primary);
}

.gos-compare__popular div {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--hos-grad);
    display: inline-block;
    margin-bottom: 6px;
}

.gos-values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
}

.gos-value-card {
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 20px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.gos-value-card i {
    color: var(--hos-primary);
    font-size: 1.4rem;
}

.gos-value-card h4 {
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--hos-text);
    margin: 0;
}

.gos-value-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--hos-text-muted);
    margin: 0;
}

/* ────────────────────────────────────────────────────────────────────────────
   13) SCREENSHOTS / MOCKUP
   ──────────────────────────────────────────────────────────────────────────── */
.gos-screen {
    position: relative;
}

.gos-mockup {
    position: relative;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 20px;
    box-shadow: var(--hos-shadow-lg);
    overflow: hidden;
}

.gos-mockup__windows {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 18px;
    background: var(--hos-bg-soft);
    border-bottom: 1px solid var(--hos-border);
}

.gos-mockup__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #f87171;
    display: inline-block;
}

.gos-mockup__dot:nth-child(2) {
    background: #fbbf24;
}

.gos-mockup__dot:nth-child(3) {
    background: #34d399;
}

.gos-mockup__title {
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--hos-text-muted);
    font-family: var(--hos-font-display);
}

.gos-mockup__bar {
    height: 44px;
    background: var(--hos-surface);
    border-bottom: 1px solid var(--hos-border);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 18px;
}

.gos-mockup__bar i {
    width: 92px;
    height: 10px;
    border-radius: 6px;
    background: var(--hos-bg-soft);
}

.gos-mockup__bar i:nth-child(2) {
    width: 48px;
}

.gos-mockup__screen {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.gos-mockup__screen i {
    height: 26px;
    border-radius: 10px;
    background: var(--hos-bg-soft);
    display: block;
}

.gos-slide-inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 22px;
    padding: 28px;
    box-shadow: var(--hos-shadow);
}

.gos-slide-caption {
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--hos-text);
}

.gos-slide-desc {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--hos-text-muted);
}

/* ────────────────────────────────────────────────────────────────────────────
   14) DASHBOARD MOCKUP (BENTO)
   ──────────────────────────────────────────────────────────────────────────── */
.gos-dash__grid {
    display: grid;
    gap: 16px;
}

.gos-dash__nav {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
}

.gos-dash__title {
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--hos-text);
}

.gos-dash__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.gos-dash__side,
.gos-dash__main {
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 18px;
    padding: 18px;
}

.gos-bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: minmax(118px, auto);
    gap: 16px;
}

@media (max-width: 820px) {
    .gos-bento {
        grid-template-columns: repeat(2, 1fr);
    }
}

.gos-bento__item {
    grid-column: span 2;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 22px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.gos-bento__item--wide {
    grid-column: span 3;
    grid-row: span 2;
}

.gos-bento__icon {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: var(--hos-primary-soft);
    color: var(--hos-primary);
    display: grid;
    place-items: center;
    font-size: 1.1rem;
}

.gos-bento__stats {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.gos-bento__kpi-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.gos-bento__kpi {
    font-weight: 700;
    font-size: 1.1rem;
}

.gos-bento__kpi small {
    color: var(--hos-text-muted);
    font-weight: 600;
    font-size: 0.78rem;
}

.gos-bento__row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
}

.gos-bento__room-strip,
.gos-bento__guest-pill,
.gos-bento__ticket-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 5px 11px;
    border-radius: 999px;
    background: var(--hos-primary-soft);
    color: var(--hos-primary);
}

.gos-bento__ticket {
    border: 1px solid var(--hos-border);
    border-radius: 14px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.gos-bento__ticket-sla {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--hos-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.gos-bento__guest-av {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--hos-grad);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    display: grid;
    place-items: center;
}

.gos-bento__extra {
    font-size: 0.8rem;
    color: var(--hos-text-muted);
}

/* ────────────────────────────────────────────────────────────────────────────
   15) STATS / KPI
   ──────────────────────────────────────────────────────────────────────────── */
.gos-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
}

.gos-stat,
.gos-stat-block {
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 16px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.gos-stat__value,
.gos-stat-block__value {
    font-family: var(--hos-font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--hos-text);
}

.gos-stat__label,
.gos-stat-block__label {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--hos-text-muted);
}

.gos-stat__trend {
    font-size: 0.78rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.gos-trend--up,
.gos-trend--down {
    color: var(--hos-teal-600);
}

.gos-stat-band {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    background: var(--hos-bg-soft);
    border: 1px solid var(--hos-border);
    border-radius: 22px;
    padding: 34px;
}

.gos-rooms {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.gos-room {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--hos-text);
}

.gos-room-legend {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--hos-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.gos-rooms-card,
.gos-chart-card,
.gos-card {
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 18px;
    padding: 20px;
}

.gos-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.gos-card-title {
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1rem;
    color: var(--hos-text);
}

.gos-activity {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.gos-activity__item {
    display: flex;
    align-items: center;
    gap: 12px;
}

.gos-activity__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--hos-primary);
    flex-shrink: 0;
}

.gos-activity__meta {
    font-size: 0.82rem;
    color: var(--hos-text-muted);
}

.gos-bars {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    height: 140px;
}

.gos-bar {
    flex: 1;
    border-radius: 8px 8px 4px 4px;
    background: var(--hos-grad);
    opacity: 0.85;
}

.gos-bars-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--hos-text-muted);
    margin-top: 8px;
}

/* ────────────────────────────────────────────────────────────────────────────
   16) TESTIMONIALS / FAQ / CTA
   ──────────────────────────────────────────────────────────────────────────── */
.gos-story {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
}

.gos-quote {
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 22px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--hos-shadow-sm);
}

.gos-quote i.pi-quote-left {
    font-size: 1.5rem;
    color: var(--hos-primary);
}

.gos-quote__text {
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--hos-text);
    margin: 0;
}

.gos-quote__author {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--hos-text-muted);
}

.gos-faq-wrap {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.gos-faq {
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 18px;
    overflow: hidden;
}

.gos-faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: none;
    border: 0;
    padding: 18px 22px;
    font-family: var(--hos-font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--hos-text);
    cursor: pointer;
    text-align: left;
}

.gos-faq__icon {
    color: var(--hos-primary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
}

.gos-faq.is-open .gos-faq__icon {
    transform: rotate(180deg);
}

.gos-faq__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
}

.gos-faq__panel-inner {
    padding: 0 22px 20px;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--hos-text-muted);
}

.gos-cta {
    position: relative;
    border-radius: 28px;
    padding: clamp(40px, 6vw, 72px);
    background:
        radial-gradient(55% 80% at 15% 20%, rgba(20, 184, 166, 0.45) 0%, transparent 60%),
        radial-gradient(50% 70% at 90% 80%, rgba(99, 102, 241, 0.4) 0%, transparent 60%),
        linear-gradient(150deg, var(--hos-slate-900), #13263f);
    text-align: center;
    color: #fff;
    overflow: hidden;
}

.gos-cta__title {
    font-family: var(--hos-font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 14px;
}

.gos-cta__text {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 28px;
}

/* ────────────────────────────────────────────────────────────────────────────
   17) PÁGINAS INTERNAS (page hero, blog, contacto, integraciones)
   ──────────────────────────────────────────────────────────────────────────── */
.gos-page {
    min-height: 100vh;
}

.gos-page-hero {
    padding: clamp(56px, 8vh, 96px) 0;
    text-align: center;
    background: var(--hos-bg-soft);
    border-bottom: 1px solid var(--hos-border);
}

.gos-page-hero__title {
    font-family: var(--hos-font-display);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--hos-text);
    margin: 0 0 14px;
}

.gos-page-hero__subtitle {
    font-size: 1.06rem;
    color: var(--hos-text-muted);
    max-width: 620px;
    margin: 0 auto;
    line-height: 1.6;
}

.gos-breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--hos-text-muted);
    margin-bottom: 18px;
}

.gos-breadcrumb a {
    color: var(--hos-primary);
    text-decoration: none;
}

.gos-blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
}

.gos-blog-card {
    display: flex;
    flex-direction: column;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.gos-blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--hos-shadow);
}

.gos-blog-card__thumb {
    aspect-ratio: 16/9;
    background: var(--hos-grad);
    display: grid;
    place-items: center;
    color: #fff;
    font-size: 1.8rem;
}

.gos-blog-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
}

.gos-blog-card__meta {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hos-primary);
}

.gos-blog-card__title {
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1.12rem;
    line-height: 1.35;
    color: var(--hos-text);
}

.gos-blog-card__card-excerpt {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--hos-text-muted);
}

.gos-blog-article {
    max-width: 760px;
    margin-inline: auto;
}

.gos-blog-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--hos-text-muted);
    margin-bottom: 26px;
    flex-wrap: wrap;
}

.gos-contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 48px;
    align-items: start;
}

@media (max-width: 880px) {
    .gos-contact-grid {
        grid-template-columns: 1fr;
    }
}

.gos-contact-info {
    display: flex;
    flex-direction: column;
    gap: 22px;
}

.gos-contact-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
}

.gos-contact-item__label {
    display: block;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--hos-primary);
    margin-bottom: 3px;
}

.gos-contact-item__value {
    font-size: 0.98rem;
    color: var(--hos-text);
}

.gos-contact-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.gos-contact-nudge {
    font-size: 0.85rem;
    color: var(--hos-text-muted);
    text-align: center;
}

.gos-contact-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
    padding: 40px;
}

.gos-contact-success__icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--hos-primary-soft);
    color: var(--hos-primary);
    display: grid;
    place-items: center;
    font-size: 1.6rem;
}

.gos-integrations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
}

.gos-integration {
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 18px;
    padding: 18px 20px;
    transition: transform 0.18s ease, border-color 0.18s ease;
}

.gos-integration:hover {
    transform: translateY(-2px);
    border-color: rgba(20, 184, 166, 0.4);
}

/* ────────────────────────────────────────────────────────────────────────────
   18) CAROUSEL
   ──────────────────────────────────────────────────────────────────────────── */
.gos-carousel {
    position: relative;
}

.gos-carousel__viewport {
    overflow: hidden;
}

.gos-carousel__track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.gos-carousel__slide {
    flex: 0 0 100%;
    padding: 8px;
}

.gos-carousel__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--hos-border);
    background: var(--hos-surface);
    color: var(--hos-text);
    cursor: pointer;
    transition: border-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
}

.gos-carousel__nav:hover {
    border-color: var(--hos-primary);
    color: var(--hos-primary);
    transform: translateY(-2px);
}

.gos-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
}

.gos-carousel__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    background: var(--hos-border);
    cursor: pointer;
    transition: background 0.16s ease, width 0.2s ease;
    padding: 0;
}

.gos-carousel__dot.is-active {
    background: var(--hos-primary);
    width: 24px;
    border-radius: 999px;
}

/* ────────────────────────────────────────────────────────────────────────────
   19) PRICING
   ──────────────────────────────────────────────────────────────────────────── */
.gos-plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    align-items: stretch;
}

.gos-plan {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--hos-surface);
    border: 1px solid var(--hos-border);
    border-radius: 24px;
    padding: 30px;
    transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.gos-plan:hover {
    transform: translateY(-4px);
    box-shadow: var(--hos-shadow);
}

.gos-plan--popular {
    border-color: rgba(20, 184, 166, 0.55);
    box-shadow: 0 24px 55px -24px rgba(20, 184, 166, 0.55);
}

.gos-plan--enterprise {
    background: linear-gradient(160deg, var(--hos-slate-900), #13263f);
    border-color: transparent;
    color: #fff;
}

.gos-plan__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
}

.gos-plan__name {
    font-family: var(--hos-font-display);
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--hos-text);
}

.gos-plan__badge {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--hos-grad);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.gos-plan__desc {
    font-size: 0.92rem;
    color: var(--hos-text-muted);
    margin: 0;
}

.gos-plan__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 22px;
}

.gos-plan__amount {
    font-family: var(--hos-font-display);
    font-size: 2.6rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--hos-text);
    line-height: 1;
}

.gos-plan__period {
    font-size: 0.92rem;
    color: var(--hos-text-muted);
}

.gos-plan__price--custom {
    font-family: var(--hos-font-display);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--hos-text);
}

.gos-plan__features {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
}

.gos-plan__features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.94rem;
    color: var(--hos-text);
}

.gos-plan__features li i {
    color: var(--hos-primary);
    font-size: 0.95rem;
}

.gos-plan--enterprise .gos-plan__name,
.gos-plan--enterprise .gos-plan__amount,
.gos-plan--enterprise .gos-plan__price--custom {
    color: #fff;
}

.gos-plan--enterprise .gos-plan__desc {
    color: rgba(255, 255, 255, 0.7);
}

.gos-plan--enterprise .gos-plan__features li {
    color: rgba(255, 255, 255, 0.9);
}

.gos-plan--enterprise .gos-plan__features li i {
    color: var(--hos-teal-300);
}

.gos-plan__custom-icon {
    color: var(--hos-primary);
    font-size: 1.4rem;
}

.gos-plan__custom-label {
    font-weight: 800;
    color: var(--hos-text);
}

.gos-plan__custom-sub {
    font-size: 0.85rem;
    color: var(--hos-text-muted);
}

/* ────────────────────────────────────────────────────────────────────────────
   20) UTILIDADES / EFECTOS
   ──────────────────────────────────────────────────────────────────────────── */
.gos-landing,
.gos {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.gos-landing {
    background: var(--hos-bg);
}

.hos-hover-lift {
    transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.hos-hover-lift:hover {
    transform: translateY(-4px);
    box-shadow: var(--hos-shadow);
}

.hos-hover-scale {
    transition: transform 0.22s ease;
}

.hos-hover-scale:hover {
    transform: scale(1.03);
}

.hos-bento-reveal {
    animation: gos-fade-up 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.hos-bento-rotate {
    transition: transform 0.5s ease;
}

.hos-bento-rotate:hover {
    transform: rotate(-3deg) scale(1.02);
}

.hos-bento-border {
    border: 1px solid rgba(20, 184, 166, 0.22);
}

.hos-bento-glow {
    box-shadow: 0 24px 55px -24px rgba(20, 184, 166, 0.5);
}

.hos-bento-gradient {
    background: var(--hos-grad);
    color: #fff;
}

/* ────────────────────────────────────────────────────────────────────────────
   21) ANIMACIONES DE ENTRADA (reveal / stagger / count-up / scroll)
   ──────────────────────────────────────────────────────────────────────────── */
.gos-reveal,
.gos-reveal-up,
.gos-reveal-down,
.gos-reveal-left,
.gos-reveal-right,
.gos-reveal-scale,
.gos-reveal-blur {
    opacity: 0;
    will-change: opacity, transform, filter;
    transition:
        opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        filter 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--gos-delay, 0s);
}

.gos-reveal-up {
    transform: translateY(28px);
}

.gos-reveal-down {
    transform: translateY(-28px);
}

.gos-reveal-left {
    transform: translateX(-32px);
}

.gos-reveal-right {
    transform: translateX(32px);
}

.gos-reveal-scale {
    transform: scale(0.92);
}

.gos-reveal-blur {
    filter: blur(12px);
}

.gos-reveal.gos-is-visible,
.gos-reveal-up.gos-is-visible,
.gos-reveal-down.gos-is-visible,
.gos-reveal-left.gos-is-visible,
.gos-reveal-right.gos-is-visible,
.gos-reveal-scale.gos-is-visible,
.gos-reveal-blur.gos-is-visible {
    opacity: 1;
    transform: none;
    filter: none;
}

/* Stagger: los hijos aparecen en cascada */
.gos-stagger > * {
    opacity: 0;
    transform: translateY(24px);
    transition:
        opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.gos-stagger.gos-is-visible > * {
    opacity: 1;
    transform: none;
}

.gos-stagger.gos-is-visible > *:nth-child(1) { transition-delay: 0.05s; }
.gos-stagger.gos-is-visible > *:nth-child(2) { transition-delay: 0.12s; }
.gos-stagger.gos-is-visible > *:nth-child(3) { transition-delay: 0.19s; }
.gos-stagger.gos-is-visible > *:nth-child(4) { transition-delay: 0.26s; }
.gos-stagger.gos-is-visible > *:nth-child(5) { transition-delay: 0.33s; }
.gos-stagger.gos-is-visible > *:nth-child(6) { transition-delay: 0.4s; }
.gos-stagger.gos-is-visible > *:nth-child(7) { transition-delay: 0.47s; }
.gos-stagger.gos-is-visible > *:nth-child(8) { transition-delay: 0.54s; }
.gos-stagger.gos-is-visible > *:nth-child(9) { transition-delay: 0.61s; }
.gos-stagger.gos-is-visible > *:nth-child(10) { transition-delay: 0.68s; }

/* Count-up numerics */
.gos-count {
    font-variant-numeric: tabular-nums;
}

/* Nav acoplado al scroll */
.gos-nav--scrolled {
    box-shadow: 0 8px 30px -16px rgba(15, 23, 42, 0.25);
}

@media (prefers-reduced-motion: reduce) {
    .gos-reveal,
    .gos-reveal-up,
    .gos-reveal-down,
    .gos-reveal-left,
    .gos-reveal-right,
    .gos-reveal-scale,
    .gos-reveal-blur,
    .gos-stagger > * {
        opacity: 1 !important;
        transform: none !important;
        filter: none !important;
        transition: none !important;
    }
}

/* ────────────────────────────────────────────────────────────────────────────
   ANIMACIONES
   ──────────────────────────────────────────────────────────────────────────── */
@keyframes gos-spin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes gos-fade-up {
    from {
        opacity: 0;
        transform: translateY(22px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes gos-fade-in {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

@keyframes gos-marquee {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-50%);
    }
}

@keyframes gos-float {
    0%,
    100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-12px);
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    ::before,
    ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
    }
}